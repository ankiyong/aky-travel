<!-- Client-side Interactive Logic -->
<script>
  // Filter Handlers
  const regionTabs = document.querySelectorAll('.region-filter');
  const themeChips = document.querySelectorAll('.theme-chip');
  const dexCards = document.querySelectorAll('.dex-card');
  const dexCountEl = document.getElementById('dex-count');
  const btnReset = document.getElementById('btn-reset-filters');

  let currentRegion = 'all';
  let activeThemes = new Set();

  function applyFilters() {
    let visibleCount = 0;
    dexCards.forEach(card => {
      const cardRegion = card.dataset.region;
      const cardThemes = card.dataset.themes ? card.dataset.themes.split(' ') : [];

      const regionMatch = (currentRegion === 'all') || (cardRegion === currentRegion);
      const themeMatch = (activeThemes.size === 0) || Array.from(activeThemes).some(t => cardThemes.includes(t));

      if (regionMatch && themeMatch) {
        card.classList.remove('hidden');
        visibleCount++;
      } else {
        card.classList.add('hidden');
      }
    });

    if (dexCountEl) {
      dexCountEl.textContent = visibleCount;
    }
  }

  regionTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      regionTabs.forEach(t => {
        t.classList.remove('bg-primary', 'text-on-primary', 'shadow-sm');
        t.classList.add('text-on-surface-variant');
      });
      tab.classList.add('bg-primary', 'text-on-primary', 'shadow-sm');
      tab.classList.remove('text-on-surface-variant');

      currentRegion = tab.dataset.region;
      applyFilters();
    });
  });

  themeChips.forEach(chip => {
    chip.addEventListener('click', () => {
      const theme = chip.dataset.theme;
      if (activeThemes.has(theme)) {
        activeThemes.delete(theme);
        chip.classList.remove('bg-primary', 'text-on-primary');
        chip.classList.add('bg-surface-container', 'text-on-surface-variant');
      } else {
        activeThemes.add(theme);
        chip.classList.remove('bg-surface-container', 'text-on-surface-variant');
        chip.classList.add('bg-primary', 'text-on-primary');
      }
      applyFilters();
    });
  });

  if (btnReset) {
    btnReset.addEventListener('click', () => {
      currentRegion = 'all';
      activeThemes.clear();

      regionTabs.forEach((t, i) => {
        if (i === 0) {
          t.classList.add('bg-primary', 'text-on-primary', 'shadow-sm');
          t.classList.remove('text-on-surface-variant');
        } else {
          t.classList.remove('bg-primary', 'text-on-primary', 'shadow-sm');
          t.classList.add('text-on-surface-variant');
        }
      });

      themeChips.forEach(chip => {
        chip.classList.remove('bg-primary', 'text-on-primary');
        chip.classList.add('bg-surface-container', 'text-on-surface-variant');
      });

      applyFilters();
    });
  }

  // Stamp / Collect Toggle
  function toggleCardCollect(button) {
    const icon = button.querySelector('.material-symbols-outlined');
    const isCollected = icon.textContent === 'bookmark';
    if (isCollected) {
      icon.textContent = 'bookmark_border';
      icon.style.fontVariationSettings = "'FILL' 0";
      button.classList.remove('text-tertiary');
      button.classList.add('text-outline');
    } else {
      icon.textContent = 'bookmark';
      icon.style.fontVariationSettings = "'FILL' 1";
      button.classList.remove('text-outline');
      button.classList.add('text-tertiary');
    }
  }

  // Modal Controls
  const detailModal = document.getElementById('detail-modal');
  const modalPanel = document.getElementById('modal-panel');

  function openDetailModal() {
    if (!detailModal || !modalPanel) return;
    detailModal.classList.remove('opacity-0', 'pointer-events-none');
    detailModal.classList.add('opacity-100');
    modalPanel.classList.remove('scale-95');
    modalPanel.classList.add('scale-100');
  }

  function closeDetailModal() {
    if (!detailModal || !modalPanel) return;
    detailModal.classList.add('opacity-0', 'pointer-events-none');
    detailModal.classList.remove('opacity-100');
    modalPanel.classList.add('scale-95');
    modalPanel.classList.remove('scale-100');
  }

  // Close modal when clicking on backdrop
  if (detailModal) {
    detailModal.addEventListener('click', (e) => {
      if (e.target === detailModal) {
        closeDetailModal();
      }
    });
  }

  function copyAddress(btn) {
    navigator.clipboard?.writeText("충청남도 공주시 웅진로 280");
    const label = btn.querySelector('span:last-child');
    if (label) {
      const original = label.textContent;
      label.textContent = "복사됨!";
      setTimeout(() => { label.textContent = original; }, 1500);
    }
  }

  function handleModalCollect(btn) {
    btn.innerHTML = `<span class="material-symbols-outlined text-[18px]">check_circle</span><span>도감 수집 완료!</span>`;
    btn.classList.remove('bg-primary');
    btn.classList.add('bg-tertiary');
  }
